# Hébergement OVH de ceramodent.fr. Copié tel quel dans dist/ par `npm run build`.

Options -Indexes
RewriteEngine On

# HTTPS obligatoire et une seule adresse : ceramodent.fr (www, ceramodent.com… redirigés définitivement)
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} !^ceramodent\.fr$ [NC]
RewriteRule ^(.*)$ https://ceramodent.fr/$1 [R=301,L]

# Page « introuvable » du site (et non celle d'OVH)
ErrorDocument 404 /404.html

# Dépôt Git d'OVH (dossier .git) : jamais accessible
RedirectMatch 404 /\.git

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Fichiers compilés (nom unique à chaque version) : cache long. Pages HTML : toujours revalidées.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|png|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
